# API Server
PORT=8002
HOST=0.0.0.0

# Security
API_KEY=your-api-key-here

# OpenAI (for embedding + chat)
OPENAI_API_KEY=your-openai-api-key-here
# CHAT_MODEL=gpt-6-luna    # RAG Chat 問答模型（預設 gpt-6-luna）
# REPORT_MODEL=gpt-6-sol       # 週報生成模型（預設 gpt-6-sol）

# vocus-warehouse（rag-api）：K8s Secret vocus-warehouse-db-rag 掛載路徑；未設 = 本機檔案模式
# VW_DB_SECRET_FILE_RAG=/var/run/secrets/db-rag
# PGSSLROOTCERT=/etc/ssl/rds/global-bundle.pem

# Data paths (relative to project root)
OUTPUT_DIR=../output
SCRIPTS_DIR=../scripts

# Laminar observability (https://laminar.sh)
LMNR_PROJECT_API_KEY=your_laminar_project_api_key

# Rate limiting
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_CHAT=20
RATE_LIMIT_GENERATE=5
